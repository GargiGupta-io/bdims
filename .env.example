# Copy this file to .env and fill it in. NEVER commit .env.
# Local development needs NONE of these. Only Sepolia deployment does.

# Alchemy (free tier) -> create a Sepolia app -> copy the HTTPS URL
SEPOLIA_RPC_URL=

# Private key of a DEDICATED deployer wallet holding only Sepolia test ETH.
# Never use the key of a wallet that holds anything real.
PRIVATE_KEY=

# etherscan.io -> API Keys (free). Needed for contract verification.
ETHERSCAN_API_KEY=

# pinata.cloud -> API Keys (free tier). Needed from week 9 for IPFS uploads.
PINATA_JWT=

# Set to true to print a gas table after tests.
REPORT_GAS=false
